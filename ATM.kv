<WindowManager>:
    LoginScreen:
        name: "login"
    MenuScreen:
        name: "menu"
    BalanceScreen:
        name: "balance"
    TransactionScreen:
        name: "transaction"
    DetailsScreen:
        name: "details"

<LoginScreen>:
    BoxLayout:
        orientation: "vertical"
        padding: 25
        spacing: 15

        Label:
            text: "ATM Login"
            font_size: "26sp"
            size_hint_y: None
            height: "50dp"

        TextInput:
            id: pin_input
            hint_text: "Enter PIN (1111)"
            password: True
            input_filter: "int"
            multiline: False
            size_hint_y: None
            height: "48dp"

        Button:
            text: "Login"
            size_hint_y: None
            height: "48dp"
            on_release: root.verify_pin(pin_input.text)

        Label:
            id: error_label
            text: ""
            color: 1, 0.2, 0.2, 1

<MenuScreen>:
    BoxLayout:
        orientation: "vertical"
        padding: 25
        spacing: 12

        Label:
            text: root.welcome_text
            font_size: "22sp"

        Button:
            text: "Check Balance"
            size_hint_y: None
            height: "48dp"
            on_release: app.root.current = "balance"

        Button:
            text: "Deposit"
            size_hint_y: None
            height: "48dp"
            on_release:
                app.root.get_screen("transaction").transaction_type = "Deposit"
                app.root.get_screen("transaction").message_text = ""
                app.root.current = "transaction"

        Button:
            text: "Withdraw"
            size_hint_y: None
            height: "48dp"
            on_release:
                app.root.get_screen("transaction").transaction_type = "Withdraw"
                app.root.get_screen("transaction").message_text = ""
                app.root.current = "transaction"

        Button:
            text: "Account Details"
            size_hint_y: None
            height: "48dp"
            on_release: app.root.current = "details"

        Button:
            text: "Logout"
            size_hint_y: None
            height: "48dp"
            on_release:
                app.root.get_screen("login").ids.pin_input.text = ""
                app.root.current = "login"

<BalanceScreen>:
    BoxLayout:
        orientation: "vertical"
        padding: 25
        spacing: 20

        Label:
            text: root.balance_text
            font_size: "24sp"

        Button:
            text: "Back to Menu"
            size_hint_y: None
            height: "48dp"
            on_release: app.root.current = "menu"

<TransactionScreen>:
    BoxLayout:
        orientation: "vertical"
        padding: 25
        spacing: 15

        Label:
            text: root.transaction_type + " Cash"
            font_size: "22sp"
            size_hint_y: None
            height: "45dp"

        TextInput:
            id: amount_input
            hint_text: "Enter amount"
            input_filter: "int"
            multiline: False
            size_hint_y: None
            height: "48dp"

        Button:
            text: "Confirm"
            size_hint_y: None
            height: "48dp"
            on_release: root.perform_transaction(amount_input.text)

        Label:
            text: root.message_text
            halign: "center"

        Button:
            text: "Back to Menu"
            size_hint_y: None
            height: "48dp"
            on_release:
                amount_input.text = ""
                app.root.current = "menu"

<DetailsScreen>:
    BoxLayout:
        orientation: "vertical"
        padding: 25
        spacing: 20

        Label:
            text: root.details_text
            font_size: "20sp"

        Button:
            text: "Back to Menu"
            size_hint_y: None
            height: "48dp"
            on_release: app.root.current = "menu"
