[app]

# Title of your application
title = MyATMApp

# Package name
package.name = myatmapp

# Package domain
package.domain = org.atm

# Source files to include
source.dir = .
source.include_exts = py,png,jpg,kv,atlas

# Application version
version = 0.1

# Application requirements
requirements = python3,kivy

# Supported orientations
orientation = portrait

# Fullscreen mode
fullscreen = 0

# Permissions
android.permissions = INTERNET

# Target Android API, should be as high as possible
android.api = 33

# Minimum API your APK will support
android.minapi = 21

# Android SDK version to use
android.sdk = 33

# Android NDK version to use
android.ndk = 25b

# Automatically accept Android SDK licenses
android.accept_sdk_license = True

[buildozer]
log_level = 2
